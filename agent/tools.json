{
  "$comment": "Astra 에이전트 도구 목록 — 백엔드 REST 프록시만 노출 (기하 계산 도구 없음: 지시서 7/10절). 베이스 URL은 배포 시 주입.",
  "tools": [
    {
      "name": "health",
      "description": "검수 백엔드 상태 확인",
      "method": "GET",
      "path": "/healthz"
    },
    {
      "name": "list_spaces",
      "description": "프로젝트의 공간 목록 조회",
      "method": "GET",
      "path": "/api/v1/projects/{projectId}/spaces"
    },
    {
      "name": "list_space_assets",
      "description": "공간의 검수 자산 목록 조회",
      "method": "GET",
      "path": "/api/v1/spaces/{spaceId}/assets"
    },
    {
      "name": "get_asset",
      "description": "자산 상세 (designPose, 공차, revision)",
      "method": "GET",
      "path": "/api/v1/assets/{assetId}"
    },
    {
      "name": "get_observation",
      "description": "관측(측정) 상세 — ICP 지표·판정 사유 포함",
      "method": "GET",
      "path": "/api/v1/observations/{observationId}"
    },
    {
      "name": "list_inspection_results",
      "description": "판정 결과 목록 (observationId/assetId/spaceId 필터)",
      "method": "GET",
      "path": "/api/v1/inspection-results"
    },
    {
      "name": "create_report",
      "description": "현황 보고서 생성 (계산은 서버가 수행, 에이전트는 포맷만)",
      "method": "POST",
      "path": "/api/v1/reports"
    },
    {
      "name": "get_report",
      "description": "보고서 조회",
      "method": "GET",
      "path": "/api/v1/reports/{reportId}"
    }
  ],
  "prohibited": [
    "좌표 변환/ICP/판정 로직의 클라이언트 측 재구현",
    "decision 필드의 에이전트 자체 재작성 (서버 값 인용만 허용)",
    "spatial_core 직접 임포트"
  ]
}
